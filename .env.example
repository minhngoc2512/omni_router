# ─────────────────────────────────────────────────────────────────────────────
#  OmniRoute — Docker deployment configuration (TEMPLATE)
#  Create .env from this file and fill in the secrets in section 3 (see README.md):
#    ./setup.sh            (or: cp .env.example .env)
#  docker-compose.yml uses .env in two ways:
#    1. ${...} interpolation inside the compose file (ports, host paths, image tag…)
#    2. env_file: every variable is passed into the container
#  Full variable reference: https://github.com/diegosouzapw/OmniRoute/blob/main/.env.example
#  ⚠️  .env contains secrets — never commit it, and back it up together with data/.
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════ 1. IMAGE & CONTAINER ══════════════════════════
# latest = newest stable release. Pin a specific version (e.g. 3.8.50) to avoid unintended upgrades.
OMNIROUTE_IMAGE_TAG=latest
TZ=Asia/Ho_Chi_Minh

# Node V8 heap (MB). 1024 is enough for the dashboard / light chat.
# For coding agents (Claude Code, Codex…) use ≥ 8192 and raise CONTAINER_MEM_LIMIT accordingly.
OMNIROUTE_MEMORY_MB=2048
# Container memory limit — always larger than OMNIROUTE_MEMORY_MB.
CONTAINER_MEM_LIMIT=3g

# ═════════════════════════════ 2. PORTS & NETWORK ════════════════════════════
# Host address the ports are published on:
#   127.0.0.1 → reachable from this machine only (safe; use with a reverse proxy)
#   0.0.0.0   → open to the LAN / Internet
BIND_ADDRESS=127.0.0.1

# Dashboard + API (/v1/*) port in single-port mode.
PORT=20128
# WebSocket port for the realtime dashboard (live monitoring).
LIVE_WS_PORT=20132
# Must bind 0.0.0.0 inside the container for port mapping to work.
LIVE_WS_HOST=0.0.0.0
# Add public origins (e.g. https://omni.example.com) when accessed via another domain/IP.
LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128

# Public dashboard URL (used for OAuth callbacks and displayed endpoints).
# Change to https://your-domain when running behind a reverse proxy.
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# ═════════════════════════════ 3. AUTH & SECURITY ════════════════════════════
# Initial dashboard login password (only used while the DB is empty).
# Change it after logging in: Dashboard → Settings → Security.
INITIAL_PASSWORD=

# Signs dashboard session cookies.            Generate: openssl rand -base64 48
JWT_SECRET=
# Encrypts API keys stored in the DB.         Generate: openssl rand -hex 32
# ⚠️  Changing this after data exists breaks the stored keys.
API_KEY_SECRET=
# Secret for the Codex Responses WebSocket bridge. Generate: openssl rand -base64 32
OMNIROUTE_WS_BRIDGE_SECRET=
MACHINE_ID_SALT=

# SQLite at-rest encryption key. If not set here, OmniRoute generates one on first
# boot and stores it in ${DATA_PATH}/server.env (next to the DB; backing up data/ covers it).
# ⚠️  Losing/changing the key → data cannot be read. Never delete data/server.env.
# STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# true = every request to /v1/* requires an API key (create one in Dashboard → API Keys).
REQUIRE_API_KEY=true
# true when the dashboard is served over HTTPS (TLS reverse proxy). Required for public domains.
AUTH_COOKIE_SECURE=false
ALLOW_API_KEY_REVEAL=false

# ═════════════════════════════ 4. DATA ═══════════════════════════════════════
# Directory on the HOST (relative to docker-compose.yml).
DATA_PATH=./data
# Directory inside the container — must match the volume mount in the compose file.
DATA_DIR=/app/data
# Automatic SQLite backup on startup/migration (false = backups enabled, at most 1 per hour).
DISABLE_SQLITE_AUTO_BACKUP=false
# Each backup is a FULL copy of the DB → keep it bounded to avoid filling the disk.
# Upstream default: 20 copies, no age-based deletion (0).
DB_BACKUP_MAX_FILES=5
DB_BACKUP_RETENTION_DAYS=14

# Redis (rate limiter + cache). Redis data is stored in REDIS_DATA_PATH on the host.
REDIS_URL=redis://redis:6379
REDIS_DATA_PATH=./redis

# ═════════════════════════════ 5. LOGS ═══════════════════════════════════════
# Log directory on the HOST, mounted at /app/logs in the container.
LOG_PATH=./logs
APP_LOG_TO_FILE=true
APP_LOG_FILE_PATH=/app/logs/app.log
# debug | info | warn | error
APP_LOG_LEVEL=info
# text | json
APP_LOG_FORMAT=text
# Rotation: when app.log > MAX_FILE_SIZE → renamed to app.<timestamp>.log and a new file is created.
# Max disk usage ≈ (APP_LOG_MAX_FILES + 1) × APP_LOG_MAX_FILE_SIZE  (currently ≈ 550MB)
APP_LOG_MAX_FILE_SIZE=50M
APP_LOG_MAX_FILES=10
# Delete rotated files older than N days (runs at startup only; the file-count cap runs every minute).
APP_LOG_RETENTION_DAYS=7
APP_LOG_ROTATION_CHECK_INTERVAL_MS=60000

# Request/call logs stored in SQLite (data/) — pruned by age and row count
CALL_LOG_RETENTION_DAYS=7
CALL_LOGS_TABLE_MAX_ROWS=100000
PROXY_LOGS_TABLE_MAX_ROWS=100000

# Container stdout logs (docker logs) — rotated by Docker, at most SIZE × FILE per container
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# ═════════════════════════════ 6. BACKUP (./backup.sh) ═══════════════════════
# Directory for omniroute-backup-*.zip files (relative to the project directory, or absolute)
BACKUP_DIR=./backups
# Number of backups to keep (0 = keep all)
BACKUP_KEEP=7
