# ─────────────────────────────────────────────────────────────────────────────
#  OmniRoute — cấu hình triển khai Docker (MẪU)
#  Copy thành .env rồi điền các secret ở mục 3 (xem README.md):
#    cp .env.example .env
#  .env được docker-compose.yml dùng theo 2 cách:
#    1. Nội suy biến ${...} trong compose (port, đường dẫn host, image tag…)
#    2. env_file: toàn bộ biến được nạp vào container
#  Tài liệu đầy đủ các biến: https://github.com/diegosouzapw/OmniRoute/blob/main/.env.example
#  ⚠️  File chứa secret — không commit, và nhớ backup cùng thư mục data.
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════ 1. IMAGE & CONTAINER ══════════════════════════
# latest = bản stable mới nhất. Pin phiên bản cụ thể (vd 3.8.50) để tránh tự nâng cấp.
OMNIROUTE_IMAGE_TAG=latest
TZ=Asia/Ho_Chi_Minh

# Heap V8 cho Node (MB). 1024 đủ cho dashboard/chat nhẹ.
# Dùng cho coding agent (Claude Code, Codex…) nên ≥ 8192 và tăng CONTAINER_MEM_LIMIT tương ứng.
OMNIROUTE_MEMORY_MB=2048
# Giới hạn RAM container — luôn đặt lớn hơn OMNIROUTE_MEMORY_MB.
CONTAINER_MEM_LIMIT=3g

# ═════════════════════════════ 2. PORT & MẠNG ════════════════════════════════
# Địa chỉ host để publish port:
#   127.0.0.1 → chỉ truy cập từ máy này (an toàn, dùng khi có reverse proxy)
#   0.0.0.0   → mở cho LAN / Internet
BIND_ADDRESS=127.0.0.1

# Port dashboard + API (/v1/*) ở chế độ single-port.
PORT=20128
# Port WebSocket cho dashboard realtime (live monitoring).
LIVE_WS_PORT=20132
# Bên trong container phải bind 0.0.0.0 để port mapping hoạt động.
LIVE_WS_HOST=0.0.0.0
# Thêm origin public (vd https://omni.example.com) nếu truy cập qua domain/IP khác.
LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128

# URL public của dashboard (dùng cho OAuth callback, hiển thị endpoint).
# Đổi thành https://your-domain nếu chạy sau reverse proxy.
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# ═════════════════════════════ 3. AUTH & BẢO MẬT ═════════════════════════════
# Mật khẩu đăng nhập dashboard lần đầu (chỉ dùng khi DB còn trống).
# Sau khi đăng nhập có thể đổi ở Dashboard → Settings → Security.
INITIAL_PASSWORD=

# Ký session cookie dashboard.            Tạo mới: openssl rand -base64 48
JWT_SECRET=
# Mã hoá API key lưu trong DB.             Tạo mới: openssl rand -hex 32
# ⚠️  Đổi giá trị này sau khi đã có dữ liệu sẽ làm hỏng các key đã lưu.
API_KEY_SECRET=
# Secret cho Codex Responses WebSocket bridge. Tạo mới: openssl rand -base64 32
OMNIROUTE_WS_BRIDGE_SECRET=
MACHINE_ID_SALT=

# Key mã hoá SQLite at-rest. Không đặt ở đây → lần chạy đầu OmniRoute tự sinh
# và lưu vào ${DATA_PATH}/server.env (nằm cùng DB, backup thư mục data là đủ).
# ⚠️  Mất/đổi key → không đọc được dữ liệu. Đừng xoá data/server.env.
# STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# true = mọi request tới /v1/* phải có API key (tạo trong Dashboard → API Keys).
REQUIRE_API_KEY=true
# true khi truy cập dashboard qua HTTPS (reverse proxy có TLS). Bắt buộc với domain public.
AUTH_COOKIE_SECURE=false
ALLOW_API_KEY_REVEAL=false

# ═════════════════════════════ 4. DỮ LIỆU ════════════════════════════════════
# Thư mục trên HOST (tương đối so với docker-compose.yml).
DATA_PATH=./data
# Thư mục bên trong container — phải khớp với volume mount trong compose.
DATA_DIR=/app/data
# Tự backup SQLite mỗi lần khởi động/migration (false = bật backup, tối đa 1 bản/giờ).
DISABLE_SQLITE_AUTO_BACKUP=false
# Mỗi bản backup là 1 bản sao ĐẦY ĐỦ của DB → giới hạn để không đầy ổ.
# Mặc định upstream: 20 bản, không xoá theo tuổi (0).
DB_BACKUP_MAX_FILES=5
DB_BACKUP_RETENTION_DAYS=14

# Redis (rate limiter + cache). Dữ liệu Redis lưu ở REDIS_DATA_PATH trên host.
REDIS_URL=redis://redis:6379
REDIS_DATA_PATH=./redis

# ═════════════════════════════ 5. LOG ════════════════════════════════════════
# Thư mục log trên HOST, mount vào /app/logs trong container.
LOG_PATH=./logs
APP_LOG_TO_FILE=true
APP_LOG_FILE_PATH=/app/logs/app.log
# debug | info | warn | error
APP_LOG_LEVEL=info
# text | json
APP_LOG_FORMAT=text
# Xoay vòng: khi app.log > MAX_FILE_SIZE → đổi tên thành app.<thời gian>.log, tạo file mới.
# Dung lượng tối đa ≈ (APP_LOG_MAX_FILES + 1) × APP_LOG_MAX_FILE_SIZE  (hiện tại ≈ 550MB)
APP_LOG_MAX_FILE_SIZE=50M
APP_LOG_MAX_FILES=10
# Xoá file đã xoay cũ hơn N ngày (chỉ chạy lúc khởi động; giới hạn số file chạy mỗi phút).
APP_LOG_RETENTION_DAYS=7
APP_LOG_ROTATION_CHECK_INTERVAL_MS=60000

# Log request/call lưu trong SQLite (data/) — tự dọn theo tuổi và số dòng
CALL_LOG_RETENTION_DAYS=7
CALL_LOGS_TABLE_MAX_ROWS=100000
PROXY_LOGS_TABLE_MAX_ROWS=100000

# Log stdout của container (docker logs) — Docker tự xoay vòng, tối đa SIZE × FILE mỗi container
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
